class Vehicle:
    def __init__(self, brand):
        self.brand = brand

    def describe(self):
        print(f"This is a {self.brand}")

class Car(Vehicle):
    def __init__(self, brand, doors):
        super().__init__(brand)
        self.doors = doors

    def describe(self):
        super().describe()
        print(f"It has {self.doors} doors")

my_car = Car("Toyota", 4)
my_car.describe()
>> This is a Toyota
>> It has 4 doors
